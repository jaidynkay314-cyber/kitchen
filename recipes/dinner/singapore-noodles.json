 "steps": [
  {
   "title": "Soak the noodles",
   "text": "Cover the vermicelli with boiling water for 3 to 4 minutes, drain, rinse cold and snip into shorter lengths with scissors.",
   "timer": 240
  },
  {
   "title": "Egg",
   "text": "Hot wok, a drop of the oil. Scramble the eggs into a thin omelette, roll it up and slice. Set aside.",
   "timer": 120
  },
  {
   "title": "Chicken and prawns",
   "text": "Add the rest of the oil, cook the chicken until nearly done, then the prawns until pink. Set aside.",
   "timer": 300
  },
  {
   "title": "Veg and spice",
   "text": "Stir-fry the capsicum, garlic and spring onion 1 minute, then add the curry powder for 30 seconds.",
   "timer": 90
  },
  {
   "title": "Toss it together",
   "text": "Add the noodles, soy, oyster sauce, sesame oil and a splash of water and toss until evenly yellow. Return the chicken, prawns and egg and toss through.",
   "timer": 120
  }
 ],
 "notes": "Tongs are your friend here: lift and toss rather than stir, or the noodles clump.",
