 "steps": [
  {
   "title": "Rice and pickles",
   "text": "Put the rice on. Toss the cucumber with the rice vinegar and a pinch each of salt and sugar. Leave it to pickle while you cook. Brown rice takes about 30 minutes.",
   "timer": 1800
  },
  {
   "title": "Mix the sauce",
   "text": "Stir together the gochujang, soy, honey, garlic and ginger.",
   "timer": 0
  },
  {
   "title": "Cook the beef",
   "text": "Hot pan, high heat. Brown the mince well, breaking it up, until any liquid cooks off and it starts to crisp.",
   "timer": 420
  },
  {
   "title": "Sauce the beef",
   "text": "Add the sauce and toss for a minute until sticky. Finish with the sesame oil.",
   "timer": 60
  },
  {
   "title": "Fry the eggs",
   "text": "Wipe the pan, a little spray oil, and fry the eggs to your liking.",
   "timer": 180
  },
  {
   "title": "Bowl up",
   "text": "Rice, beef, drained cucumber, egg on top, spring onion over everything.",
   "timer": 0
  }
 ],
