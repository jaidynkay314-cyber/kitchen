 "steps": [
  {
   "title": "Marinate",
   "text": "Mix the yoghurt, spices, lemon juice, garlic, ginger and salt. Slash the chicken a few times and coat well. At least 30 minutes, ideally overnight.",
   "timer": 1800
  },
  {
   "title": "Salad",
   "text": "Toss the cucumber, onion and mint with a squeeze of lemon and a pinch of salt.",
   "timer": 0
  },
  {
   "title": "Grill",
   "text": "Hot barbecue. Cook the chicken until charred at the edges and cooked through, about 5 to 6 minutes a side.",
   "timer": 660
  },
  {
   "title": "Naan and serve",
   "text": "Warm the naan on the barbecue for the last minute. Serve with the salad and tzatziki.",
   "timer": 60
  }
