 "steps": [
  {
   "title": "Rice and lettuce",
   "text": "Put the rice on. Separate the lettuce into whole cup-shaped leaves, rinse, and chill them in the fridge so they're crisp. Brown rice takes about 30 minutes.",
   "timer": 1800
  },
  {
   "title": "Brown the mince",
   "text": "Heat the sesame oil in a wok on high. Add both minces and cook, breaking it up, until browned and any liquid has cooked off.",
   "timer": 420
  },
  {
   "title": "Add the veg",
   "text": "Add the garlic, ginger, carrot and capsicum and stir-fry 2 minutes.",
   "timer": 120
  },
  {
   "title": "Sauce it",
   "text": "Add the oyster, soy and hoisin sauces and toss until glossy. Stir through most of the spring onion.",
   "timer": 60
  },
  {
   "title": "Serve",
   "text": "Spoon into lettuce cups, top with the rest of the spring onion, and serve with the rice on the side.",
   "timer": 0
  }
 ],
