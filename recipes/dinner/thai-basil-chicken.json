 "steps": [
  {
   "title": "Rice on, prep",
   "text": "Cook the rice. Pound or finely chop the garlic and chilli together. Mix the oyster, soy, fish sauce and honey.",
   "timer": 900
  },
  {
   "title": "Fry the eggs",
   "text": "Heat the oil in a wok until very hot and fry the eggs until the edges are crispy. Set aside.",
   "timer": 120
  },
  {
   "title": "Garlic, chilli, chicken",
   "text": "Same wok, high heat. Fry the garlic and chilli 20 seconds, add the mince and cook, breaking it up, until browned.",
   "timer": 300
  },
  {
   "title": "Beans and sauce",
   "text": "Add the beans and sauce and toss 2 minutes until the beans are just tender.",
   "timer": 120
  },
  {
   "title": "Basil and serve",
   "text": "Off the heat, stir through the basil until wilted. Serve over rice with the egg on top.",
